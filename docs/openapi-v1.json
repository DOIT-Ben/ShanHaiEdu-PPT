{
  "openapi": "3.1.0",
  "info": {
    "title": "PPT Agent API",
    "version": "1.0.0",
    "description": "Host-independent API for durable PPT Agent runs."
  },
  "servers": [{ "url": "/" }],
  "security": [{ "bearerAuth": [] }],
  "paths": {
    "/health/live": {
      "get": {
        "operationId": "getLiveness",
        "description": "Process liveness. This does not imply that the worker loop is making progress.",
        "security": [],
        "responses": {
          "200": { "description": "HTTP process is alive", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Liveness" } } } }
        }
      }
    },
    "/health/ready": {
      "get": {
        "operationId": "getReadiness",
        "description": "Worker readiness based on heartbeat, tick age, and the latest tick result.",
        "security": [],
        "responses": {
          "200": { "description": "Worker is ready", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Readiness" } } } },
          "503": { "description": "HTTP is alive but worker is not ready", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Readiness" } } } }
        }
      }
    },
    "/v1/admin/planning-failures": {
      "get": {
        "operationId": "aggregatePlanningFailures",
        "description": "Tenant-scoped, administrator-only aggregation of redacted planning failures.",
        "parameters": [
          { "name": "errorCode", "in": "query", "schema": { "type": "string", "minLength": 1, "maxLength": 100 } },
          { "name": "model", "in": "query", "schema": { "type": "string", "minLength": 1, "maxLength": 120 } },
          { "name": "contractVersion", "in": "query", "schema": { "type": "string", "minLength": 1, "maxLength": 40 } }
        ],
        "responses": {
          "200": { "description": "Aggregated planning failures", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PlanningFailureReport" } } } },
          "403": { "$ref": "#/components/responses/Error" },
          "4XX": { "$ref": "#/components/responses/Error" },
          "500": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/v1/admin/operations": {
      "get": {
        "operationId": "getOperationsReport",
        "description": "Tenant-scoped administrator report with filtered Runs, SLA watchdog findings, reconciliation queue, and service metrics.",
        "parameters": [
          { "name": "status", "in": "query", "schema": { "type": "string" } },
          { "name": "externalUserId", "in": "query", "schema": { "type": "string", "maxLength": 160 } },
          { "name": "errorCode", "in": "query", "schema": { "type": "string", "maxLength": 100 } },
          { "name": "createdFrom", "in": "query", "schema": { "type": "string", "format": "date-time" } },
          { "name": "createdTo", "in": "query", "schema": { "type": "string", "format": "date-time" } },
          { "name": "offset", "in": "query", "schema": { "type": "integer", "minimum": 0, "default": 0 } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 50 } }
        ],
        "responses": {
          "200": { "description": "Operations report" },
          "403": { "$ref": "#/components/responses/Error" },
          "4XX": { "$ref": "#/components/responses/Error" },
          "500": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/v1/admin/operations/{runId}/actions": {
      "post": {
        "operationId": "applyOperationsAction",
        "description": "Idempotently reinspects or manually reconciles one Step with an administrator audit event.",
        "parameters": [
          { "$ref": "#/components/parameters/RunId" },
          { "$ref": "#/components/parameters/IdempotencyKey" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": ["stepId", "action", "expectedVersion", "reason"],
                "properties": {
                  "stepId": { "type": "string", "minLength": 1, "maxLength": 160 },
                  "action": { "enum": ["REINSPECT", "MARK_NOT_CHARGED", "MARK_CHARGED"] },
                  "expectedVersion": { "type": "integer", "minimum": 0 },
                  "reason": { "type": "string", "minLength": 8, "maxLength": 500 }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Applied or replayed administrator action" },
          "403": { "$ref": "#/components/responses/Error" },
          "4XX": { "$ref": "#/components/responses/Error" },
          "500": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/v1/runs": {
      "post": {
        "operationId": "createRun",
        "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateRunRequest" } } }
        },
        "responses": {
          "201": { "description": "Run created", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RunEnvelope" } } } },
          "200": { "description": "Idempotent replay", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RunEnvelope" } } } },
          "4XX": { "$ref": "#/components/responses/Error" },
          "500": { "$ref": "#/components/responses/Error" }
        }
      },
      "get": {
        "operationId": "listRuns",
        "parameters": [
          { "name": "cursor", "in": "query", "schema": { "type": "string" } },
          { "name": "pageSize", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 20 } }
        ],
        "responses": {
          "200": { "description": "Cursor-paginated runs" },
          "4XX": { "$ref": "#/components/responses/Error" },
          "500": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/v1/runs/{runId}": {
      "get": {
        "operationId": "getRun",
        "parameters": [{ "$ref": "#/components/parameters/RunId" }],
        "responses": {
          "200": { "description": "Run snapshot and approved public artifacts" },
          "404": { "$ref": "#/components/responses/Error" },
          "500": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/v1/runs/{runId}/actions": {
      "post": {
        "operationId": "applyRunAction",
        "parameters": [
          { "$ref": "#/components/parameters/RunId" },
          { "$ref": "#/components/parameters/IdempotencyKey" }
        ],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RunAction" } } }
        },
        "responses": {
          "200": { "description": "Updated Run" },
          "4XX": { "$ref": "#/components/responses/Error" },
          "500": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/v1/runs/{runId}/events": {
      "get": {
        "operationId": "streamRunEvents",
        "description": "Replays durable events after the supplied cursor in batches of at most 100 events and 256 KiB, then shares one live poller per Run. The stream closes after a terminal run.completed, run.failed, or run.cancelled event. Clients reconnect with Last-Event-ID or after and must ignore event ids they have already applied.",
        "parameters": [
          { "$ref": "#/components/parameters/RunId" },
          { "name": "after", "in": "query", "schema": { "type": "integer", "minimum": 0 } },
          { "name": "Last-Event-ID", "in": "header", "schema": { "type": "integer", "minimum": 0 } }
        ],
        "responses": {
          "200": {
            "description": "Bounded persistent replay followed by shared live polling; closes at the Run terminal event",
            "content": { "text/event-stream": { "schema": { "type": "string" } } }
          },
          "4XX": { "$ref": "#/components/responses/Error" },
          "500": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/v1/runs/{runId}/deliveries/{deliveryId}/content": {
      "get": {
        "operationId": "downloadDeliveryContent",
        "parameters": [
          { "$ref": "#/components/parameters/RunId" },
          { "name": "deliveryId", "in": "path", "required": true, "schema": { "type": "string", "minLength": 1, "maxLength": 160 } },
          { "name": "format", "in": "query", "schema": { "enum": ["preview", "pptx", "sources"], "default": "pptx" } }
        ],
        "responses": {
          "200": { "description": "Owned PNG preview, editable PPTX, or JSON asset source manifest" },
          "4XX": { "$ref": "#/components/responses/Error" },
          "500": { "$ref": "#/components/responses/Error" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": { "type": "http", "scheme": "bearer" }
    },
    "parameters": {
      "RunId": { "name": "runId", "in": "path", "required": true, "schema": { "type": "string", "minLength": 1, "maxLength": 160 } },
      "IdempotencyKey": { "name": "Idempotency-Key", "in": "header", "required": true, "schema": { "type": "string", "minLength": 8, "maxLength": 160, "pattern": "^[A-Za-z0-9._:-]+$" } }
    },
    "responses": {
      "Error": {
        "description": "Structured error",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } } }
      }
    },
    "schemas": {
      "Liveness": {
        "type": "object",
        "additionalProperties": false,
        "required": ["service", "status", "version", "checkedAt", "startedAt", "uptimeMs"],
        "properties": {
          "service": { "const": "ppt-agent" },
          "status": { "const": "UP" },
          "version": { "type": "string" },
          "checkedAt": { "type": "string", "format": "date-time" },
          "startedAt": { "type": "string", "format": "date-time" },
          "uptimeMs": { "type": "integer", "minimum": 0 }
        }
      },
      "Readiness": {
        "type": "object",
        "additionalProperties": false,
        "required": ["service", "status", "reason", "version", "checkedAt", "worker"],
        "properties": {
          "service": { "const": "ppt-agent" },
          "status": { "enum": ["READY", "NOT_READY"] },
          "reason": { "type": ["string", "null"], "enum": ["WORKER_NOT_STARTED", "WORKER_HEARTBEAT_STALE", "WORKER_TICK_STUCK", "WORKER_TICK_FAILED", null] },
          "version": { "type": "string" },
          "checkedAt": { "type": "string", "format": "date-time" },
          "worker": {
            "type": "object",
            "additionalProperties": false,
            "required": ["tickInProgress", "tickCount", "lastHeartbeatAt", "heartbeatAgeMs", "lastTickStartedAt", "lastTickCompletedAt", "lastTickFailedAt", "tickAgeMs", "lastFailure"],
            "properties": {
              "tickInProgress": { "type": "boolean" },
              "tickCount": { "type": "integer", "minimum": 0 },
              "lastHeartbeatAt": { "type": ["string", "null"], "format": "date-time" },
              "heartbeatAgeMs": { "type": ["integer", "null"], "minimum": 0 },
              "lastTickStartedAt": { "type": ["string", "null"], "format": "date-time" },
              "lastTickCompletedAt": { "type": ["string", "null"], "format": "date-time" },
              "lastTickFailedAt": { "type": ["string", "null"], "format": "date-time" },
              "tickAgeMs": { "type": ["integer", "null"], "minimum": 0 },
              "lastFailure": {
                "oneOf": [
                  { "type": "null" },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["runId", "phase", "errorCode"],
                    "properties": {
                      "runId": { "type": ["string", "null"] },
                      "phase": { "type": ["string", "null"] },
                      "errorCode": { "type": "string" }
                    }
                  }
                ]
              }
            }
          }
        }
      },
      "HostContext": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tenantId", "externalUserId"],
        "properties": {
          "tenantId": { "type": "string", "minLength": 1, "maxLength": 160 },
          "externalUserId": { "type": "string", "minLength": 1, "maxLength": 160 },
          "externalProjectId": { "type": "string", "minLength": 1, "maxLength": 160 },
          "role": { "enum": ["USER", "ADMIN"], "default": "USER" }
        }
      },
      "DocumentSource": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "text"],
            "properties": {
              "kind": { "const": "TEXT" },
              "name": { "type": "string", "minLength": 1, "maxLength": 240 },
              "text": { "type": "string", "minLength": 20, "maxLength": 2000000 }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "attachmentId"],
            "properties": {
              "kind": { "const": "HOST_ATTACHMENT" },
              "attachmentId": { "type": "string", "minLength": 1, "maxLength": 160 }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "sources"],
            "properties": {
              "kind": { "const": "SOURCE_PACKAGE" },
              "name": { "type": "string", "minLength": 1, "maxLength": 240 },
              "sources": {
                "type": "array",
                "minItems": 1,
                "maxItems": 7,
                "items": {
                  "oneOf": [
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["kind", "sourceId", "text"],
                      "properties": {
                        "kind": { "const": "TEXT" },
                        "sourceId": { "type": "string", "minLength": 1, "maxLength": 160 },
                        "name": { "type": "string", "minLength": 1, "maxLength": 240 },
                        "text": { "type": "string", "minLength": 20, "maxLength": 2000000 }
                      }
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["kind", "sourceId", "attachmentId"],
                      "properties": {
                        "kind": { "const": "HOST_ATTACHMENT" },
                        "sourceId": { "type": "string", "minLength": 1, "maxLength": 160 },
                        "attachmentId": { "type": "string", "minLength": 1, "maxLength": 160 }
                      }
                    }
                  ]
                }
              }
            }
          }
        ]
      },
      "BlueprintSourceManifestEntry": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "kind", "status"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 160 },
          "name": { "type": "string", "minLength": 1, "maxLength": 300 },
          "kind": { "enum": ["TEXT", "IMAGE", "PDF", "MARKDOWN"] },
          "mimeType": { "type": "string", "minLength": 1, "maxLength": 160 },
          "pageCount": { "type": "integer", "minimum": 1, "maximum": 50 },
          "status": { "enum": ["READY", "FAILED"] },
          "failureCode": { "type": "string", "minLength": 1, "maxLength": 160 }
        }
      },
      "BlueprintSourceAsset": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "sourceId", "name", "mimeType", "byteLength", "sha256", "width", "height"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 160 },
          "sourceId": { "type": "string", "minLength": 1, "maxLength": 160 },
          "name": { "type": "string", "minLength": 1, "maxLength": 300 },
          "mimeType": { "enum": ["image/png", "image/jpeg", "image/webp"] },
          "byteLength": { "type": "integer", "minimum": 1, "maximum": 25165824 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "width": { "type": "integer", "minimum": 1, "maximum": 20000 },
          "height": { "type": "integer", "minimum": 1, "maximum": 20000 },
          "pageNumber": { "type": "integer", "minimum": 1, "maximum": 50 },
          "region": {
            "type": "object",
            "additionalProperties": false,
            "required": ["x", "y", "width", "height"],
            "properties": {
              "x": { "type": "number", "minimum": 0, "maximum": 1 },
              "y": { "type": "number", "minimum": 0, "maximum": 1 },
              "width": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
              "height": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
            }
          },
          "caption": { "type": "string", "minLength": 1, "maxLength": 500 },
          "ocrText": { "type": "string", "minLength": 1, "maxLength": 2000 }
        },
        "description": "Persisted source lineage metadata. Raw image bytes are intentionally excluded. Slides and editable IMAGE/TEXT elements reference these records through sourceAssetIds; IMAGE elements use REUSE_ORIGINAL, REFERENCE_GENERATION, or REGENERATE."
      },
      "CreateRunRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["schemaVersion", "host", "source", "slideCount", "visualDirection", "imageModel", "automationLevel", "budgetUnits"],
        "properties": {
          "schemaVersion": { "const": "1" },
          "host": { "$ref": "#/components/schemas/HostContext" },
          "source": { "$ref": "#/components/schemas/DocumentSource" },
          "slideCount": { "type": "integer", "minimum": 2, "maximum": 50 },
          "visualDirection": { "type": "string", "minLength": 3, "maxLength": 1000 },
          "imageModel": { "type": "string", "minLength": 1, "maxLength": 120 },
          "automationLevel": { "enum": ["SUPERVISED", "BOUNDED_AUTO"] },
          "budgetUnits": { "type": "integer", "minimum": 1, "maximum": 1000000 },
          "maxRevisionRounds": { "type": "integer", "minimum": 0, "maximum": 2, "default": 2 },
          "presentationMode": { "enum": ["SLIDE_IMAGE_V2", "LAYERED_COURSEWARE_V3"], "default": "SLIDE_IMAGE_V2" },
          "coverDesignMode": { "enum": ["INDEPENDENT", "FOLLOW_TEMPLATE"], "default": "INDEPENDENT" },
          "maxVisualAssetsPerSlide": { "type": "integer", "minimum": 1, "maximum": 4, "default": 4 }
        }
      },
      "RunAction": {
        "type": "object",
        "required": ["schemaVersion", "type", "expectedVersion"],
        "properties": {
          "schemaVersion": { "const": "1" },
          "type": { "enum": ["APPROVE_BLUEPRINT", "RETRY_PLANNING", "REPLAN", "REQUEST_BLUEPRINT_REVISION", "PAUSE", "RESUME", "CANCEL", "ADD_BUDGET", "APPROVE_REVISION", "SUBMIT_LIMITED_REVISION", "REJECT_REVISION", "ACCEPT_WITH_OVERRIDE"] },
          "expectedVersion": { "type": "integer", "minimum": 0 },
          "instruction": { "type": "string", "minLength": 3, "maxLength": 2000 },
          "reason": { "type": "string", "minLength": 3, "maxLength": 2000 },
          "mode": { "const": "STOP_NEW_SUBMISSIONS" },
          "issueIds": { "type": "array", "minItems": 1, "maxItems": 50, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 160 } },
          "slideCount": { "type": "integer", "minimum": 2, "maximum": 50 },
          "visualDirection": { "type": "string", "minLength": 3, "maxLength": 1000 },
          "additionalBudgetUnits": { "type": "integer", "minimum": 1, "maximum": 1000000 },
          "slideId": { "type": "string", "minLength": 1, "maxLength": 160 },
          "repairDomain": { "enum": ["KNOWLEDGE", "ASSET", "LAYOUT"] },
          "targetElementId": { "type": "string", "minLength": 1, "maxLength": 160 }
        }
      },
      "PublicRun": {
        "type": "object",
        "required": ["id", "host", "status", "version", "slideCount", "presentationMode", "coverDesignMode", "maxVisualAssetsPerSlide", "budgetUnits", "committedBudgetUnits", "qualityOverride", "createdAt", "updatedAt"],
        "properties": {
          "id": { "type": "string" },
          "host": { "$ref": "#/components/schemas/HostContext" },
          "status": { "type": "string" },
          "version": { "type": "integer" },
          "slideCount": { "type": "integer" },
          "visualDirection": { "type": "string" },
          "planningAttempt": { "type": "integer", "minimum": 0, "maximum": 2 },
          "maxPlanningRetries": { "const": 2 },
          "presentationMode": { "enum": ["SLIDE_IMAGE_V2", "LAYERED_COURSEWARE_V3"] },
          "coverDesignMode": { "enum": ["INDEPENDENT", "FOLLOW_TEMPLATE"] },
          "maxVisualAssetsPerSlide": { "type": "integer" },
          "budgetUnits": { "type": "integer" },
          "committedBudgetUnits": { "type": "integer" },
          "qualityOverride": { "type": "boolean" },
          "issues": { "type": "array", "items": { "$ref": "#/components/schemas/IssueSummary" } },
          "progress": {
            "type": "array",
            "description": "Materialized latest progress for steps that have not completed or failed.",
            "items": {
              "type": "object",
              "required": ["stepId", "completed", "total"],
              "properties": {
                "stepId": { "type": "string" },
                "completed": { "type": "integer", "minimum": 0 },
                "total": { "type": "integer", "minimum": 1 },
                "summary": { "type": "string", "maxLength": 500 }
              }
            }
          },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "PlanningFailure": {
        "type": "object",
        "additionalProperties": false,
        "required": ["errorCode", "retryable", "attempt", "maxAttempts", "suggestedAction", "diagnosticCode", "fieldPaths", "correlationId", "requestId", "model", "contractVersion"],
        "properties": {
          "errorCode": { "enum": ["SOURCE_INCOMPLETE", "PROVIDER_TIMEOUT", "PROVIDER_RATE_LIMIT", "PROVIDER_UNAVAILABLE", "MODEL_JSON_INVALID", "BLUEPRINT_SCHEMA_INVALID", "BLUEPRINT_SLIDE_COUNT_MISMATCH", "BLUEPRINT_SOURCE_REFERENCE_INVALID", "BLUEPRINT_SOURCE_ASSET_REFERENCE_INVALID", "BLUEPRINT_SOURCE_ASSET_MAPPING_INCOMPLETE", "V3_LAYER_CONTRACT_INVALID", "VISUAL_ASSET_LIMIT_EXCEEDED"] },
          "terminalCode": { "const": "CONTRACT_REPAIR_EXHAUSTED" },
          "retryable": { "type": "boolean" },
          "attempt": { "type": "integer", "minimum": 0 },
          "maxAttempts": { "type": "integer", "minimum": 0 },
          "suggestedAction": { "enum": ["RETRY", "MODIFY_SOURCE", "CONTACT_ADMIN"] },
          "diagnosticCode": { "type": "string", "minLength": 1, "maxLength": 100 },
          "fieldPaths": { "type": "array", "maxItems": 20, "items": { "type": "string", "minLength": 1, "maxLength": 160 } },
          "correlationId": { "type": "string", "minLength": 1, "maxLength": 160 },
          "requestId": { "type": ["string", "null"], "minLength": 1, "maxLength": 160 },
          "model": { "type": ["string", "null"], "minLength": 1, "maxLength": 120 },
          "contractVersion": { "type": "string", "minLength": 1, "maxLength": 40 }
        }
      },
      "IssueSummary": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "category", "severity", "summary", "slideIds", "sourceChunkIds", "status"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 160 },
          "category": { "type": "string" },
          "severity": { "enum": ["INFO", "WARNING", "CRITICAL"] },
          "summary": { "type": "string", "minLength": 1, "maxLength": 500 },
          "slideIds": { "type": "array", "maxItems": 50, "items": { "type": "string" } },
          "sourceChunkIds": { "type": "array", "maxItems": 200, "items": { "type": "string" } },
          "status": { "enum": ["OPEN", "RESOLVED", "ACCEPTED"] },
          "repairDomain": { "enum": ["KNOWLEDGE", "ASSET", "LAYOUT"] },
          "planningFailure": { "$ref": "#/components/schemas/PlanningFailure" }
        }
      },
      "PlanningFailureReport": {
        "type": "object",
        "additionalProperties": false,
        "required": ["data", "totalFailures"],
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["errorCode", "model", "contractVersion", "count", "lastOccurredAt"],
              "properties": {
                "errorCode": { "type": "string", "maxLength": 100 },
                "model": { "type": ["string", "null"], "maxLength": 120 },
                "contractVersion": { "type": "string", "maxLength": 40 },
                "count": { "type": "integer", "minimum": 1 },
                "lastOccurredAt": { "type": "string", "format": "date-time" }
              }
            }
          },
          "totalFailures": { "type": "integer", "minimum": 0 }
        }
      },
      "RunEnvelope": {
        "type": "object",
        "required": ["data", "replayed"],
        "properties": {
          "data": { "$ref": "#/components/schemas/PublicRun" },
          "replayed": { "type": "boolean" }
        }
      },
      "ErrorEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "required": ["error"],
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code", "message", "requestId"],
            "properties": {
              "code": { "type": "string" },
              "message": { "type": "string" },
              "requestId": { "type": "string" },
              "details": {}
            }
          }
        }
      }
    }
  }
}

{
  "name": "@doitben/ppt-agent",
  "version": "4.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "scripts/with-dev-umask.sh bun test",
    "typecheck": "scripts/with-dev-umask.sh tsc --noEmit",
    "build": "scripts/with-dev-umask.sh sh -c 'tsc -p tsconfig.build.json && mkdir -p dist/docs && cp docs/openapi-v1.json docs/openapi-v2.json dist/docs/'",
    "prepare:release": "scripts/with-dev-umask.sh bun scripts/write-release-manifest.mjs",
    "dev:mock": "scripts/with-dev-umask.sh bun src/server.ts",
    "dev:v2": "scripts/with-dev-umask.sh bun src/presentation-job-v2-server.ts",
    "eval:v4": "scripts/with-dev-umask.sh bun scripts/run-v4-real-evaluation.ts",
    "check:ownership": "bun scripts/check-dev-ownership.mjs",
    "verify:ownership": "bun scripts/verify-dev-ownership.mjs",
    "check:boundaries": "bun scripts/check-boundaries.ts",
    "check": "bun run check:boundaries && bun test && bun run typecheck && bun run build"
  },
  "dependencies": {
    "jszip": "^3.10.1",
    "pptxgenjs": "^4.0.1",
    "saxes": "^6.0.0",
    "sharp": "^0.35.3",
    "zod": "^4.0.2"
  },
  "devDependencies": {
    "@types/bun": "^1.2.18",
    "typescript": "^5.8.3"
  }
}

PPT_AGENT_HOST=127.0.0.1
PPT_AGENT_PORT=4310
PPT_AGENT_DATA_ROOT=/opt/ppt-agent/shared/data
PPT_AGENT_RUNTIME_MODE=gateway
# The release identity returned by /health/* and every V4 Run.
PPT_AGENT_SOFTWARE_VERSION=4.4.0
PPT_AGENT_TENANT_ID=frameflow
PPT_AGENT_HEARTBEAT_STALE_MS=5000
PPT_AGENT_TICK_STALE_MS=1500000
PPT_AGENT_WAITING_SLA_MS=900000
PPT_AGENT_STEP_SLA_MS=1800000
PPT_AGENT_WORKER_CONCURRENCY=2
PPT_AGENT_IMAGE_CONCURRENCY=50
# Required in gateway mode. Initial V4 pages use the Run model; automatic revisions use this edit model.
PPT_AGENT_V4_REVISION_IMAGE_MODEL=gpt-image-2
# Comma-separated gateway models advertised by GET /v1/capabilities for initial V4 page generation.
PPT_AGENT_V4_INITIAL_IMAGE_MODELS=gemini-3-pro-image-preview
# Optional isolated quick-deck evaluator. It only runs in gateway mode and must use a root beneath PPT_AGENT_DATA_ROOT.
# Its Token must differ from the V1, admin, V2 and FrameFlow Tokens. Evaluation data is TTL-cleaned and not part of Run/V2 backups.
# PPT_AGENT_QUICK_DECK_EVALUATION_API_TOKEN=replace-with-distinct-evaluator-token
# PPT_AGENT_QUICK_DECK_EVALUATION_DATA_ROOT=/opt/ppt-agent/shared/data/quick-deck-evaluations
# PPT_AGENT_QUICK_DECK_EVALUATION_TEXT_MODEL=gpt-5.6-terra
# PPT_AGENT_QUICK_DECK_EVALUATION_IMAGE_MODELS=gemini-3-pro-image-preview
# PPT_AGENT_QUICK_DECK_EVALUATION_MAX_ACTIVE_JOBS=2
# PPT_AGENT_QUICK_DECK_EVALUATION_MAX_DAILY_JOBS=10
# PPT_AGENT_QUICK_DECK_EVALUATION_TTL_HOURS=24
# PPT_AGENT_QUICK_DECK_EVALUATION_TICK_BATCH_SIZE=10
# New Runs default to the legacy reservation protocol. Enable Usage V2 only after the host endpoints are deployed.
PPT_AGENT_FRAMEFLOW_ACCOUNTING_PROTOCOL=LEGACY_RESERVATION_V1
# Required whenever V2 is enabled or persisted V2 Runs still need recovery. Values below are format examples only;
# replace every cost and pricing version with audited Provider facts before enabling FRAMEFLOW_USAGE_V2.
# PPT_AGENT_PROVIDER_BILLING_CATALOG_JSON={"schemaVersion":"1","entries":[{"model":"gemini-3-pro-image-preview","operationMode":"TEXT_TO_IMAGE","resolution":"1K","costBasis":"FIXED_PER_OPERATION","costAmountMicros":25000,"currency":"USD","providerPricingVersion":"replace-with-provider-version"},{"model":"gpt-image-2","operationMode":"IMAGE_EDIT","resolution":"1K","costBasis":"FIXED_PER_OPERATION","costAmountMicros":40000,"currency":"USD","providerPricingVersion":"replace-with-provider-version"}]}
PPT_AGENT_REVIEW_CONCURRENCY=1
PPT_AGENT_RUN_LEASE_TTL_MS=60000
PPT_AGENT_CREATE_RUN_RATE_LIMIT_PER_MINUTE=10
PPT_AGENT_RUN_ACTION_RATE_LIMIT_PER_MINUTE=60
PPT_AGENT_ASSET_SEARCH_ENABLED=true
# Optional loopback-only HTTP proxy for public asset discovery.
# PPT_AGENT_ASSET_HTTP_PROXY=http://127.0.0.1:7890
# Inbound credentials. Use distinct random values and keep this file mode 600.
PPT_AGENT_API_TOKEN=replace-with-server-only-agent-token
PPT_AGENT_ADMIN_API_TOKEN=replace-with-distinct-server-only-admin-token
# Outbound FrameFlow credential. Do not reuse either inbound credential.
FRAMEFLOW_INTERNAL_BASE_URL=http://127.0.0.1:3010
FRAMEFLOW_INTERNAL_TOKEN=replace-with-distinct-frameflow-internal-token
MODEL_GATEWAY_BASE_URL=https://newapi.doitbenai.cloud/v1
MODEL_GATEWAY_TEXT_KEY=replace-with-server-side-text-key
MODEL_GATEWAY_IMAGE_KEY=replace-with-server-side-image-key
PPT_AGENT_TEXT_MODEL=gpt-5.6-terra
PPT_AGENT_VISION_MODEL=gpt-5.6-terra
# The combined main server uses the in-process intelligent-agent provider for Presentation Job V2.
PPT_AGENT_V2_PROVIDER_MODE=internal
# V4 planning, review and revision use /responses. Set CHAT_COMPLETIONS only for a temporary gateway compatibility fallback.
PPT_AGENT_V4_TEXT_TRANSPORT=RESPONSES
# Optional text and vision fallback. It reuses MODEL_GATEWAY_BASE_URL and MODEL_GATEWAY_TEXT_KEY,
# whose gateway allowlist must include the configured fallback models. MiniMax fallback calls use Chat Completions.
PPT_AGENT_FALLBACK_MODEL_ENABLED=false
PPT_AGENT_FALLBACK_TEXT_MODEL=MiniMax-M3
PPT_AGENT_FALLBACK_VISION_MODEL=MiniMax-M3

# Presentation Job V2-only service. Run with `bun dist/presentation-job-v2-server.js` in an isolated service.
# These values are independent from every V1 and FrameFlow credential above.
PPT_AGENT_V2_HOST=127.0.0.1
PPT_AGENT_V2_PORT=4320
PPT_AGENT_V2_TENANT_ID=replace-with-host-tenant
PPT_AGENT_V2_API_TOKEN=replace-with-distinct-v2-service-token
PPT_AGENT_V2_DATA_ROOT=/opt/ppt-agent/shared/presentation-job-v2
PPT_AGENT_V2_TICK_INTERVAL_MS=500
PPT_AGENT_V2_TICK_BATCH_SIZE=25
# This isolated process cannot use `internal`. Give it a separate environment file and set `http`;
# `deterministic` is only for local contract tests and must never be a production default.
# PPT_AGENT_V2_PROVIDER_MODE=http
# PPT_AGENT_V2_PROVIDER_BASE_URL=https://provider.example/v1
# PPT_AGENT_V2_PROVIDER_API_KEY=replace-with-v2-provider-key
# PPT_AGENT_V2_PROVIDER_TIMEOUT_MS=30000
# PPT_AGENT_V2_PROVIDER_MAX_ARTIFACT_BYTES=209715200

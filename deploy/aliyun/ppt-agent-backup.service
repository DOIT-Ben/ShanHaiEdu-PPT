[Unit]
Description=PPT Agent SQLite and artifact backup
After=local-fs.target

[Service]
Type=oneshot
User=ppt-agent
Group=ppt-agent
WorkingDirectory=/opt/ppt-agent/shared
EnvironmentFile=/opt/ppt-agent/shared/ppt-agent.env
Environment=PPT_AGENT_BACKUP_ROOT=/opt/ppt-agent/shared/data-backups
Environment=PPT_AGENT_BACKUP_RETENTION_DAYS=14
Environment=PPT_AGENT_BACKUP_LOW_WATER_BYTES=5368709120
RuntimeDirectory=ppt-agent-backup
RuntimeDirectoryMode=0700
ExecStartPre=/usr/bin/test -r /opt/ppt-agent/shared/ops/backup-ppt-agent-data.mjs
ExecStart=/usr/bin/flock -n /run/ppt-agent-backup/backup.lock /usr/local/bin/bun /opt/ppt-agent/shared/ops/backup-ppt-agent-data.mjs
TimeoutStartSec=45min
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/ppt-agent/shared/data-backups

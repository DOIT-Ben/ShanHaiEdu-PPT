[Unit]
Description=PPT Agent layered courseware service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ppt-agent
Group=ppt-agent
WorkingDirectory=/opt/ppt-agent/current
EnvironmentFile=/opt/ppt-agent/shared/ppt-agent.env
ExecStart=/usr/local/bin/bun dist/server.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/ppt-agent/shared

[Install]
WantedBy=multi-user.target
